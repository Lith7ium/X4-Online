<?xml version="1.0" encoding="utf-8"?>
<!-- Isolated diagnostic only: one correlated read, no registry or world writes. -->
<mdscript name="X4AuthorityCensusRuntimeRead" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityCensusRuntimeRead'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$v" exact="event.param3"/>
   <set_value name="$i" exact="@$v.$index"/>
   <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and @$v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$last == 10054 and $i ge 1 and $i le 10054 and $i == ($i)i">
    <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$i}"/>
    <do_if value="@$ship.isoperational and $ship.isclass.ship">
     <do_if value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} != $i">
      <raise_lua_event name="'X4AuthorityCensusRuntimeRead.Result'" param="'%s|%s|%s|fault|0|0'.[$v.$request_id,$v.$epoch,$i]"/>
     </do_if>
     <do_elseif value="$ship.dock.exists or $ship.isinternallystored">
      <raise_lua_event name="'X4AuthorityCensusRuntimeRead.Result'" param="'%s|%s|%s|docked_or_stored|0|0'.[$v.$request_id,$v.$epoch,$i]"/>
     </do_elseif>
     <do_elseif value="@$ship.sector.isclass.sector">
      <raise_lua_event name="'X4AuthorityCensusRuntimeRead.Result'" param="'%s|%s|%s|ok|%s|%s'.[$v.$request_id,$v.$epoch,$i,$ship,$ship.sector]"/>
     </do_elseif>
     <do_else><raise_lua_event name="'X4AuthorityCensusRuntimeRead.Result'" param="'%s|%s|%s|no_sector|0|0'.[$v.$request_id,$v.$epoch,$i]"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityCensusRuntimeRead.Result'" param="'%s|%s|%s|unavailable|0|0'.[$v.$request_id,$v.$epoch,$i]"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityCensusRuntimeRead.Refused'"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
