<?xml version="1.0" encoding="utf-8"?>
<!-- Isolated one-fixture diagnostic; requests are one-shot and opt-in. -->
<mdscript name="X4LAN_FixtureVelocity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Start">
   <conditions><event_ui_triggered screen="'X4LAN_FixtureVelocity'" control="'Start'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <do_if value="md.X4LAN_NativeGate.Spawn.$ships? and @md.X4LAN_NativeGate.Spawn.$ships.count == 12">
     <set_value name="$ship" exact="md.X4LAN_NativeGate.Spawn.$ships.{1}"/>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship == $v.$ship and $ship.sector == $v.$sector and $ship.parent == $v.$parent and $ship.parent.isclass.zone and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
      <set_object_velocity object="$ship" constantvel="true"><linear x="10m / 1s" y="0m / 1s" z="0m / 1s"/></set_object_velocity>
      <raise_lua_event name="'X4LAN_FixtureVelocity.Start'" param="'applied'"/>
     </do_if>
     <do_else><raise_lua_event name="'X4LAN_FixtureVelocity.Start'" param="'refused'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4LAN_FixtureVelocity.Start'" param="'refused'"/></do_else>
   </actions>
  </cue>
  <cue name="Stop">
   <conditions><event_ui_triggered screen="'X4LAN_FixtureVelocity'" control="'Stop'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <do_if value="md.X4LAN_NativeGate.Spawn.$ships? and @md.X4LAN_NativeGate.Spawn.$ships.count == 12">
     <set_value name="$ship" exact="md.X4LAN_NativeGate.Spawn.$ships.{1}"/>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship == $v.$ship and $ship.sector == $v.$sector and $ship.parent == $v.$parent and $ship.parent.isclass.zone and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
      <set_object_velocity object="$ship" constantvel="false"><linear x="0m / 1s" y="0m / 1s" z="0m / 1s"/></set_object_velocity>
      <raise_lua_event name="'X4LAN_FixtureVelocity.Stop'" param="'applied'"/>
     </do_if>
     <do_else><raise_lua_event name="'X4LAN_FixtureVelocity.Stop'" param="'refused'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4LAN_FixtureVelocity.Stop'" param="'refused'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
