<?xml version="1.0" encoding="utf-8"?>
<!-- Default-off diagnostic. Install only on the designated disposable server. -->
<mdscript name="X4AuthorityJobShipEvents" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityJobShipEvents'" control="'Initialize'"/></conditions>
   <actions>
    <set_value name="$req" exact="event.param3"/>
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and $req.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $req.$capacity ge 1 and $req.$capacity le 1024 and $req.$capacity == ($req.$capacity)i">
     <set_value name="$epoch" exact="$req.$epoch"/>
     <set_value name="$capacity" exact="$req.$capacity"/>
     <set_value name="$queue" exact="table[]"/>
     <set_value name="$head" exact="1"/>
     <set_value name="$tail" exact="0"/>
     <set_value name="$inflight" exact="0"/>
     <set_value name="$observed" exact="0"/>
     <set_value name="$acknowledged" exact="0"/>
     <set_value name="$faulted" exact="false"/>
     <set_value name="$reason" exact="''"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Initialized'" param="$epoch"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Refused'"/></do_else>
   </actions>
  </cue>
  <!-- These are job activations, not a universal ship-creation event. -->
  <cue name="Activated" instantiate="true">
   <conditions><event_job_ship_activated/></conditions>
   <actions>
    <do_if value="State.$faulted? and not State.$faulted">
     <set_value name="State.$observed" exact="State.$observed + 1"/>
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and State.$tail lt 2147483647 and State.$tail - State.$head + 1 lt State.$capacity and @event.param.isclass.ship">
      <set_value name="State.$tail" exact="State.$tail + 1"/>
      <set_value name="State.$queue.{State.$tail}" exact="event.param"/>
      <do_if value="@State.$queue.{State.$tail} != event.param">
       <set_value name="State.$faulted" exact="true"/>
       <set_value name="State.$reason" exact="'queue_readback'"/>
       <raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'"/>
      </do_if>
     </do_if>
     <do_else>
      <set_value name="State.$faulted" exact="true"/>
      <set_value name="State.$reason" exact="'activation_rejected'"/>
      <raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'"/>
     </do_else>
    </do_if>
   </actions>
  </cue>
  <cue name="Status" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityJobShipEvents'" control="'Status'"/></conditions>
   <actions>
    <do_if value="State.$faulted?">
     <do_if value="not State.$faulted">
      <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted?">
       <do_if value="md.X4AuthorityShipRegistry.State.$faulted or md.X4AuthorityShipRegistry.State.$epoch != State.$epoch">
        <set_value name="State.$faulted" exact="true"/>
        <set_value name="State.$reason" exact="'registry_unhealthy'"/>
       </do_if>
      </do_if>
      <do_else><set_value name="State.$faulted" exact="true"/><set_value name="State.$reason" exact="'registry_unavailable'"/></do_else>
     </do_if>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Epoch'" param="State.$epoch"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Observed'" param="State.$observed"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Acknowledged'" param="State.$acknowledged"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Depth'" param="State.$tail - State.$head + 1"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Inflight'" param="State.$inflight"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Reason'" param="State.$reason"/>
     <do_if value="State.$faulted"><raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'"/></do_if>
     <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Healthy'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Uninitialized'"/></do_else>
   </actions>
  </cue>
  <cue name="Front" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityJobShipEvents'" control="'Front'"/></conditions>
   <actions>
    <do_if value="State.$faulted? and not State.$faulted and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and event.param3.$epoch == State.$epoch">
     <do_if value="State.$head le State.$tail">
      <do_if value="@State.$queue.{State.$head}">
       <set_value name="State.$inflight" exact="State.$head"/>
       <raise_lua_event name="'X4AuthorityJobShipEvents.Sequence'" param="State.$head"/>
       <raise_lua_event name="'X4AuthorityJobShipEvents.Actor'" param="State.$queue.{State.$head}"/>
      </do_if>
      <do_else><set_value name="State.$faulted" exact="true"/><set_value name="State.$reason" exact="'queued_object_unavailable'"/><raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'" param="State.$reason"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Empty'"/></do_else>
    </do_if>
    <do_else>
     <do_if value="State.$faulted?"><do_if value="not State.$faulted"><set_value name="State.$reason" exact="'front_refused'"/></do_if><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'" param="State.$reason"/></do_if>
     <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Refused'"/></do_else>
    </do_else>
   </actions>
  </cue>
  <cue name="Ack" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityJobShipEvents'" control="'Ack'"/></conditions>
   <actions>
    <set_value name="$actor" exact="@State.$queue.{State.$head}"/>
    <set_value name="$index" exact="@event.param3.$index"/>
    <do_if value="State.$faulted? and not State.$faulted and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$ships? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and event.param3.$epoch == State.$epoch and State.$inflight == State.$head and State.$head le State.$tail and event.param3.$sequence == State.$head and $actor and $index ge 1 and @md.X4AuthorityShipRegistry.State.$byship.{$actor} == $index and @md.X4AuthorityShipRegistry.State.$ships.{$index} == $actor">
     <remove_value name="State.$queue.{State.$head}"/>
     <set_value name="State.$head" exact="State.$head + 1"/>
     <set_value name="State.$inflight" exact="0"/>
     <set_value name="State.$acknowledged" exact="State.$acknowledged + 1"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Acked'" param="event.param3.$sequence"/>
    </do_if>
    <do_else>
     <do_if value="State.$faulted?"><do_if value="not State.$faulted"><set_value name="State.$reason" exact="'ack_refused'"/></do_if><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'" param="State.$reason"/></do_if>
     <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Refused'"/></do_else>
    </do_else>
   </actions>
  </cue>
  <cue name="Abort" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityJobShipEvents'" control="'Abort'"/></conditions>
   <actions>
    <do_if value="State.$faulted? and event.param3.$epoch == State.$epoch">
     <do_if value="not State.$faulted"><set_value name="State.$reason" exact="'driver_abort'"/></do_if>
     <set_value name="State.$faulted" exact="true"/>
     <raise_lua_event name="'X4AuthorityJobShipEvents.Faulted'"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityJobShipEvents.Refused'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
