<?xml version="1.0" encoding="utf-8"?>
<!-- Separate opt-in diagnostic. No auto-trigger, gameplay integration or transport. -->
<mdscript name="X4AuthorityNPCFlightFixture" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <!-- One order per disposable run; retain the pilot reference for guards. -->
  <cue name="Order" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityNPCFlightFixture'" control="'Order'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <set_value name="$index" exact="$v.$index"/>
    <do_if value="player.module == 'custom_creative' and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $index ge 1 and $index == ($index)i">
     <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and $ship.sector == player.sector and $ship.sector.macro.id == $v.$frame and $ship.parent.isclass.zone and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored and $ship.pilot != null">
      <set_value name="$pilot" exact="$ship.pilot"/>
      <create_position name="$destination" space="$ship.sector" object="$ship" x="3km"/>
      <create_order object="$ship" id="'MoveWait'" immediate="true" name="$order">
       <param name="destination" value="[$ship.sector, $destination]"/>
       <param name="precise" value="true"/>
       <param name="noattackresponse" value="true"/>
      </create_order>
      <!-- Creation receipt; not evidence of movement or completed order. -->
      <do_if value="@$order.exists and $order.id == 'MoveWait' and $ship.pilot == $pilot">
       <raise_lua_event name="'X4AuthorityNPCFlightFixture.Pilot'" param="$pilot"/>
       <raise_lua_event name="'X4AuthorityNPCFlightFixture.OrderId'" param="$order.id"/>
       <raise_lua_event name="'X4AuthorityNPCFlightFixture.GameTime'" param="player.age / 1s"/>
       <raise_lua_event name="'X4AuthorityNPCFlightFixture.Ready'" param="$ship"/>
      </do_if>
      <do_else><raise_lua_event name="'X4AuthorityNPCFlightFixture.Refused'"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityNPCFlightFixture.Refused'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityNPCFlightFixture.Refused'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
