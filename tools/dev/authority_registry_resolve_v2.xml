<?xml version="1.0" encoding="utf-8"?>
<!-- Isolated opt-in experiment. Existing registry state is never changed. -->
<mdscript name="X4AuthorityRegistryResolveV2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Resolve" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityRegistryResolveV2'" control="'Resolve'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <set_value name="$index" exact="$v.$index"/>
    <do_if value="md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and not md.X4AuthorityShipRegistry.State.$faulted and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $index ge 1 and $index le md.X4AuthorityShipRegistry.State.$last and $index == ($index)i">
     <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index">
      <raise_lua_event name="'X4AuthorityRegistryResolveV2.Result'" param="table[$request_id=$v.$request_id,$epoch=$v.$epoch,$index=$index,$actor=$ship,$status='ok']"/>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityRegistryResolveV2.Result'" param="table[$request_id=$v.$request_id,$epoch=$v.$epoch,$index=$index,$actor=null,$status='unavailable']"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityRegistryResolveV2.Result'" param="table[$request_id=$v.$request_id,$epoch=$v.$epoch,$index=$index,$actor=null,$status='unavailable']"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
