<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable proof experiment only; this is not a production admission gate. -->
<mdscript name="X4AuthorityCheckpointMarker" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Store" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityCheckpointMarker'" control="'Store'"/></conditions>
   <actions>
    <set_value name="$marker" exact="event.param3.$marker"/>
    <set_value name="$loaded" exact="false"/>
    <raise_lua_event name="'X4AuthorityCheckpointMarker.Stored'" param="$marker"/>
   </actions>
  </cue>
  <cue name="Loaded" instantiate="true">
   <conditions><event_game_loaded/></conditions>
   <actions>
    <do_if value="Store.$marker?"><set_value name="Store.$loaded" exact="true"/></do_if>
   </actions>
  </cue>
  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityCheckpointMarker'" control="'Inspect'"/></conditions>
   <actions>
    <do_if value="Store.$marker? and Store.$loaded? and Store.$loaded">
     <raise_lua_event name="'X4AuthorityCheckpointMarker.Inspected'" param="Store.$marker"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityCheckpointMarker.Missing'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
