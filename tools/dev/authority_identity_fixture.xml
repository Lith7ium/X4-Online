<?xml version="1.0" encoding="utf-8"?>
<!-- Only installed into the disposable identity experiment overlay. -->
<mdscript name="X4AuthorityIdentity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Spawn" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityIdentity'" control="'Spawn'"/></conditions>
   <actions>
    <do_if value="player.module == 'custom_creative' and player.ship">
     <set_value name="$ships" exact="[]"/>
     <do_all exact="2" counter="$i">
      <create_ship name="$ship" macro="macro.ship_arg_s_fighter_01_a_macro" sector="player.sector" seed="7180 + $i">
       <owner exact="faction.argon" overridenpc="true"/>
       <loadout><level exact="1.0"/><variation exact="0"/></loadout>
       <pilot><select faction="faction.argon" tags="tag.aipilot"/></pilot>
       <position x="if $i == 1 then -400m else 400m" y="100km" z="500m"/>
      </create_ship>
      <append_to_list name="$ships" exact="$ship"/>
      <create_order object="$ship" id="'Wait'" default="true"/>
     </do_all>
     <raise_lua_event name="'X4AuthorityIdentity.Spawned'" param="$ships.count"/>
    </do_if>
   </actions>
  </cue>
  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityIdentity'" control="'Inspect'"/></conditions>
   <actions>
    <do_if value="Spawn.$ships? and @Spawn.$ships.count == 2 and @Spawn.$ships.{1}.isoperational and @Spawn.$ships.{2}.isoperational">
     <raise_lua_event name="'X4AuthorityIdentity.Actor1'" param="Spawn.$ships.{1}"/>
     <raise_lua_event name="'X4AuthorityIdentity.Actor2'" param="Spawn.$ships.{2}"/>
     <raise_lua_event name="'X4AuthorityIdentity.Inspected'" param="Spawn.$ships.count"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityIdentity.Missing'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
