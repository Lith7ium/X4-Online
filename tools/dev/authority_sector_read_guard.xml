<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable read-only fixture query; caller owns pause and event serialization. -->
<mdscript name="X4AuthoritySectorReadGuard" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthoritySectorReadGuard'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$v" exact="event.param3"/>
   <do_if value="md.X4AuthoritySectorReferenceFixture.State.$epoch? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and $v.$epoch == md.X4AuthoritySectorReferenceFixture.State.$epoch and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and ($v.$slot == 1 or $v.$slot == 2)">
    <do_if value="$v.$slot == 1">
     <set_value name="$ship" exact="@md.X4AuthoritySectorReferenceFixture.State.$ship1"/>
     <set_value name="$sector" exact="@md.X4AuthoritySectorReferenceFixture.State.$sector1"/>
     <set_value name="$index" exact="@md.X4AuthoritySectorReferenceFixture.State.$index1"/>
    </do_if>
    <do_else>
     <set_value name="$ship" exact="@md.X4AuthoritySectorReferenceFixture.State.$ship2"/>
     <set_value name="$sector" exact="@md.X4AuthoritySectorReferenceFixture.State.$sector2"/>
     <set_value name="$index" exact="@md.X4AuthoritySectorReferenceFixture.State.$index2"/>
    </do_else>
    <do_if value="@$ship.isoperational and $ship.isclass.ship and @$sector.isclass.sector and $ship.sector == $sector and @md.X4AuthorityShipRegistry.State.$ships.{$index} == $ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
     <do_if value="@$ship.pilot.exists"><raise_lua_event name="'X4AuthoritySectorReadGuard.Pilot'" param="'present'"/></do_if>
     <do_else><raise_lua_event name="'X4AuthoritySectorReadGuard.Pilot'" param="'absent'"/></do_else>
     <do_if value="@$ship.order.exists">
      <raise_lua_event name="'X4AuthoritySectorReadGuard.OrderId'" param="$ship.order.id"/>
      <do_if value="@$ship.order.state == orderstate.started"><raise_lua_event name="'X4AuthoritySectorReadGuard.OrderState'" param="'started'"/></do_if>
      <do_elseif value="@$ship.order.state == orderstate.critical"><raise_lua_event name="'X4AuthoritySectorReadGuard.OrderState'" param="'critical'"/></do_elseif>
      <do_else><raise_lua_event name="'X4AuthoritySectorReadGuard.OrderState'" param="'other'"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthoritySectorReadGuard.OrderId'" param="'none'"/><raise_lua_event name="'X4AuthoritySectorReadGuard.OrderState'" param="'none'"/></do_else>
     <raise_lua_event name="'X4AuthoritySectorReadGuard.Actor'" param="$ship"/>
     <raise_lua_event name="'X4AuthoritySectorReadGuard.Sector'" param="$sector"/>
     <raise_lua_event name="'X4AuthoritySectorReadGuard.Verified'" param="$v.$epoch"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthoritySectorReadGuard.Refused'"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthoritySectorReadGuard.Refused'"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
