<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only saved baseline reference; caller fences checkpoint and load. -->
<mdscript name="X4AuthoritySavedBaselineMotionBind" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Bind" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthoritySavedBaselineMotionBind'" control="'Bind'"/></conditions>
  <actions>
   <set_value name="$r" exact="event.param3"/>
   <set_value name="$ok" exact="false"/>
   <do_if value="$r.$request_id? and $r.$epoch? and $r.$index? and $r.$sector_macro? and $r.$baseline?">
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted?">
     <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and $r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $r.$baseline ge 1 and $r.$baseline == ($r.$baseline)i and $r.$baseline le md.X4AuthorityShipRegistry.State.$last">
      <do_if value="$r.$index ge 1 and $r.$index le $r.$baseline and $r.$index == ($r.$index)i">
       <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$index}"/>
       <find_sector name="$matches" macro="macro.{$r.$sector_macro}" multiple="true" required="false"/>
       <do_if value="@$ship.isoperational and $ship.isclass.ship and not $ship.dock.exists and not $ship.isinternallystored">
        <do_if value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} == $r.$index and @$matches.count == 1 and @$matches.{1}.isclass.sector">
         <do_if value="@$ship.sector.isclass.sector and $ship.sector == $matches.{1} and $ship.sector.macro.id == $r.$sector_macro">
          <set_value name="$sector" exact="$ship.sector"/><set_value name="$ok" exact="true"/>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </do_if>
   <do_if value="$ok"><raise_lua_event name="'X4AuthoritySavedBaselineMotionBind.Result'" param="'%s|Bound|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$sector]"/></do_if>
   <do_else><raise_lua_event name="'X4AuthoritySavedBaselineMotionBind.Result'" param="'%s|Unavailable|'.[$r.$request_id]"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
