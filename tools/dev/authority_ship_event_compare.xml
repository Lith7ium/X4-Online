<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in, disposable local observation. No registry mutation or ship creation. -->
<mdscript name="X4AuthorityShipEventCompare" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityShipEventCompare'" control="'Initialize'"/></conditions>
   <actions>
    <set_value name="$req" exact="event.param3"/>
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$last?">
     <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == $req.$epoch and $req.$capacity ge 1 and $req.$capacity le 1024 and $req.$capacity == ($req.$capacity)i">
      <set_value name="$epoch" exact="$req.$epoch"/><set_value name="$generation" exact="$req.$generation"/><set_value name="$capacity" exact="$req.$capacity"/>
      <set_value name="$actors" exact="table[]"/><set_value name="$kinds" exact="table[]"/><set_value name="$indices" exact="table[]"/>
      <set_value name="$head" exact="1"/><set_value name="$tail" exact="0"/><set_value name="$inflight" exact="0"/><set_value name="$faulted" exact="false"/>
      <raise_lua_event name="'X4AuthorityShipEventCompare.Initialized'" param="$generation"/>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'initialize'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'registry_unavailable'"/></do_else>
   </actions>
  </cue>
  <cue name="God" instantiate="true"><conditions><event_god_created_ship/></conditions><actions><run_actions ref="Capture"><param name="Actor" value="event.param"/><param name="Kind" value="'god'"/></run_actions></actions></cue>
  <cue name="PlayerBuilt" instantiate="true"><conditions><event_player_built_ship/></conditions><actions><run_actions ref="Capture"><param name="Actor" value="event.param"/><param name="Kind" value="'player_build'"/></run_actions></actions></cue>
  <cue name="JobActivated" instantiate="true"><conditions><event_job_ship_activated/></conditions><actions><run_actions ref="Capture"><param name="Actor" value="event.param"/><param name="Kind" value="'activation'"/></run_actions></actions></cue>
  <cue name="GalaxyEntered" instantiate="true"><conditions><event_object_entered space="player.galaxy"/></conditions><actions>
   <do_if value="State.$faulted? and not State.$faulted">
    <do_if value="event.param"><do_if value="@event.param.isclass.ship"><run_actions ref="Capture"><param name="Actor" value="event.param"/><param name="Kind" value="'galaxy_enter'"/></run_actions></do_if></do_if>
    <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'galaxy_actor_missing'"/></do_else>
   </do_if>
  </actions></cue>
  <library name="Capture" purpose="run_actions">
   <params><param name="Actor"/><param name="Kind"/></params>
   <actions>
    <do_if value="State.$faulted? and not State.$faulted">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$last?">
      <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and $Actor and @$Actor.isclass.ship and State.$tail lt 2147483647 and State.$tail - State.$head + 1 lt State.$capacity">
       <set_value name="$found" exact="@md.X4AuthorityShipRegistry.State.$byship.{$Actor}"/>
       <do_if value="not $found or ($found ge 1 and $found == ($found)i and $found le md.X4AuthorityShipRegistry.State.$last and @md.X4AuthorityShipRegistry.State.$ships.{$found} == $Actor)">
        <set_value name="State.$tail" exact="State.$tail + 1"/>
        <set_value name="State.$actors.{State.$tail}" exact="$Actor"/><set_value name="State.$kinds.{State.$tail}" exact="$Kind"/>
        <set_value name="$storedindex" exact="0"/><do_if value="$found"><set_value name="$storedindex" exact="$found"/></do_if>
        <set_value name="State.$indices.{State.$tail}" exact="$storedindex"/>
        <do_if value="@State.$actors.{State.$tail} != $Actor or @State.$kinds.{State.$tail} != $Kind or @State.$indices.{State.$tail} != $storedindex"><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'queue_readback'"/></do_if>
       </do_if>
       <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'registry_binding'"/></do_else>
      </do_if>
      <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'capture_or_overflow'"/></do_else>
     </do_if>
     <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'registry_unavailable'"/></do_else>
    </do_if>
   </actions>
  </library>
  <cue name="Front" instantiate="true"><conditions><event_ui_triggered screen="'X4AuthorityShipEventCompare'" control="'Front'"/></conditions><actions>
   <do_if value="State.$faulted? and not State.$faulted and event.param3.$epoch == State.$epoch and event.param3.$generation == State.$generation and State.$inflight == 0">
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch">
    <do_if value="State.$head le State.$tail">
     <do_if value="@State.$actors.{State.$head} and @State.$kinds.{State.$head}">
      <set_value name="State.$inflight" exact="State.$head"/>
      <raise_lua_event name="'X4AuthorityShipEventCompare.Result'" param="'%s|item|%s|%s|%s|%s'.[event.param3.$request_id,State.$head,State.$kinds.{State.$head},State.$indices.{State.$head},State.$actors.{State.$head}]"/>
     </do_if>
     <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'queued_actor_unavailable'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityShipEventCompare.Result'" param="'%s|empty'.[event.param3.$request_id]"/></do_else>
    </do_if>
    <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'registry_unhealthy'"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'front_refused'"/></do_else>
  </actions></cue>
  <cue name="Ack" instantiate="true"><conditions><event_ui_triggered screen="'X4AuthorityShipEventCompare'" control="'Ack'"/></conditions><actions>
   <do_if value="State.$faulted? and not State.$faulted and event.param3.$epoch == State.$epoch and event.param3.$generation == State.$generation and State.$inflight == State.$head and event.param3.$sequence == State.$head">
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch">
    <remove_value name="State.$actors.{State.$head}"/><remove_value name="State.$kinds.{State.$head}"/><remove_value name="State.$indices.{State.$head}"/>
    <set_value name="State.$head" exact="State.$head + 1"/><set_value name="State.$inflight" exact="0"/>
    <raise_lua_event name="'X4AuthorityShipEventCompare.Result'" param="'%s|acked|%s'.[event.param3.$request_id,event.param3.$sequence]"/>
    </do_if>
    <do_else><set_value name="State.$faulted" exact="true"/><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'registry_unhealthy'"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityShipEventCompare.Faulted'" param="'ack_refused'"/></do_else>
  </actions></cue>
 </cues>
</mdscript>
