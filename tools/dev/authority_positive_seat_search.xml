<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in, bounded read-only diagnostic. No automatic update or installation. -->
<mdscript name="X4AuthorityPositiveSeatSearch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityPositiveSeatSearch'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$v" exact="event.param3"/>
   <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and @$v.$epoch and @$v.$request_id and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch">
    <set_value name="$zone" exact="player.zone"/>
    <do_if value="@$zone.isclass.zone and @player.ship.isoperational and player.ship.zone == $zone">
     <!-- sortlimit applies only with multiple and an explicit sort criterion. -->
     <find_ship name="$ships" space="$zone" multiple="true" required="false" sortbydistanceto="player.ship" sortlimit="32"/>
     <do_if value="$ships.count &lt;= 32">
     <set_value name="$found" exact="false"/>
     <set_value name="$invalidslot" exact="false"/>
     <do_all exact="$ships.count" counter="$i">
      <do_if value="not $found and not $invalidslot">
       <set_value name="$ship" exact="$ships.{$i}"/>
       <do_if value="$ship.isoperational and $ship.isclass.ship and $ship.zone == $zone and $ship.sector.isclass.sector and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
        <!-- Never suppress getter failures or treat them as empty. -->
        <set_value name="$pilot" exact="$ship.assignedpilot"/>
        <do_if value="$pilot">
         <set_value name="$post" exact="$ship.controlpostslot.{controlpost.aipilot}"/>
         <do_if value="$post and $post.component">
          <set_value name="$reserved" exact="$post.component.slotactor.{$post}"/>
          <do_if value="$reserved">
           <set_value name="$found" exact="true"/>
           <set_value name="$chosen" exact="$ship"/>
           <set_value name="$sector" exact="$ship.sector"/>
          </do_if>
         </do_if>
         <do_else><set_value name="$invalidslot" exact="true"/></do_else>
        </do_if>
       </do_if>
      </do_if>
     </do_all>
     <do_if value="$found and not $invalidslot">
      <raise_lua_event name="'X4AuthorityPositiveSeatSearch.Result'" param="'%s|%s|%s|%s|%s|occupied'.[$v.$request_id,$v.$epoch,$chosen,$sector,$zone]"/>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityPositiveSeatSearch.Inconclusive'" param="'%s|%s|inconclusive'.[$v.$request_id,$v.$epoch]"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityPositiveSeatSearch.Inconclusive'" param="'%s|%s|inconclusive'.[$v.$request_id,$v.$epoch]"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityPositiveSeatSearch.Inconclusive'" param="'%s|%s|inconclusive'.[$v.$request_id,$v.$epoch]"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityPositiveSeatSearch.Refused'"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
