<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only saved fixture sector enumeration; actor handles remain local. -->
<mdscript name="X4AuthorityFixtureFrameRead" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityFixtureFrameRead'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$r" exact="event.param3"/>
   <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship?">
    <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and @$r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$last == 4">
     <do_if value="@$r.$slot == 1 or @$r.$slot == 2">
      <set_value name="$index" exact="$r.$slot + 2"/>
      <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
      <do_if value="@$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and @$ship.sector.isclass.sector">
       <set_value name="$sector" exact="$ship.sector"/>
       <do_if value="($r.$slot == 1 and @$sector.macro.id == 'cluster_33_sector001_macro') or ($r.$slot == 2 and @$sector.macro.id == 'cluster_45_sector001_macro')">
        <find_station name="$stations" space="$sector" multiple="true" required="false"/>
        <do_if value="@$stations.count le 128">
         <raise_lua_event name="'X4AuthorityFixtureFrameRead.Result'" param="'%s|ship|%s|%s|%s|%s|%s'.[$r.$request_id,$ship,$sector,@$ship.idcode,@$ship.macro.id,@$ship.owner.id]"/>
         <set_value name="$emitted" exact="0"/>
         <do_all exact="$stations.count" counter="$i">
          <set_value name="$station" exact="$stations.{$i}"/>
          <do_if value="@$station.isoperational and $station.isclass.station and @$station.sector == $sector">
           <raise_lua_event name="'X4AuthorityFixtureFrameRead.Result'" param="'%s|station|%s|%s|%s|%s|%s'.[$r.$request_id,$station,$sector,@$station.idcode,@$station.macro.id,@$station.owner.id]"/>
           <set_value name="$emitted" exact="$emitted + 1"/>
          </do_if>
         </do_all>
         <raise_lua_event name="'X4AuthorityFixtureFrameRead.Done'" param="'%s|%s'.[$r.$request_id,$emitted]"/>
        </do_if>
        <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
       </do_if>
       <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
      </do_if>
      <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityFixtureFrameRead.Refused'" param="$r.$request_id"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
