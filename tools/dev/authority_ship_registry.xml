<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable, opt-in MD experiment. Not an installed extension. -->
<mdscript name="X4AuthorityShipRegistry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <!-- This cue owns the saved register. It is deliberately never reset. -->
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityShipRegistry'" control="'Initialize'"/></conditions>
   <actions>
    <set_value name="$epoch" exact="event.param3.$epoch"/>
    <set_value name="$ships" exact="table[]"/>
    <set_value name="$last" exact="0"/>
    <set_value name="$byship" exact="table[]"/>
    <set_value name="$faulted" exact="false"/>
    <raise_lua_event name="'X4AuthorityShipRegistry.Initialized'" param="$epoch"/>
   </actions>
  </cue>
  <cue name="Status" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityShipRegistry'" control="'Status'"/></conditions>
   <actions>
    <do_if value="State.$faulted? and State.$faulted">
     <raise_lua_event name="'X4AuthorityShipRegistry.Faulted'"/>
    </do_if>
    <do_elseif value="State.$ships? and State.$epoch?">
     <raise_lua_event name="'X4AuthorityShipRegistry.Epoch'" param="State.$epoch"/>
     <raise_lua_event name="'X4AuthorityShipRegistry.Count'" param="State.$last"/>
    </do_elseif>
    <do_else><raise_lua_event name="'X4AuthorityShipRegistry.Uninitialized'"/></do_else>
   </actions>
  </cue>
  <cue name="Enroll" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityShipRegistry'" control="'Enroll'"/></conditions>
   <actions>
    <set_value name="$ship" exact="event.param3.$ship"/>
    <do_if value="State.$ships? and State.$byship? and State.$epoch? and State.$faulted? and not State.$faulted and event.param3.$epoch == State.$epoch and @$ship.isoperational and $ship.isclass.ship">
     <!-- Object reference key semantics, including after reload, require native validation. -->
     <set_value name="$found" exact="@State.$byship.{$ship}"/>
     <do_if value="$found">
      <do_if value="$found ge 1 and $found le State.$last and @State.$ships.{$found} == $ship">
       <raise_lua_event name="'X4AuthorityShipRegistry.Enrolled'" param="$found"/>
      </do_if>
      <do_else>
       <set_value name="State.$faulted" exact="true"/>
       <raise_lua_event name="'X4AuthorityShipRegistry.Refused'"/>
      </do_else>
     </do_if>
     <do_else>
      <set_value name="State.$last" exact="State.$last + 1"/>
      <set_value name="$found" exact="State.$last"/>
      <set_value name="State.$ships.{$found}" exact="$ship"/>
      <set_value name="State.$byship.{$ship}" exact="$found"/>
      <do_if value="@State.$ships.{$found} == $ship and @State.$byship.{$ship} == $found">
       <raise_lua_event name="'X4AuthorityShipRegistry.Enrolled'" param="$found"/>
      </do_if>
      <do_else>
       <set_value name="State.$faulted" exact="true"/>
       <raise_lua_event name="'X4AuthorityShipRegistry.Refused'"/>
      </do_else>
     </do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityShipRegistry.Refused'"/></do_else>
   </actions>
  </cue>
  <cue name="Resolve" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityShipRegistry'" control="'Resolve'"/></conditions>
   <actions>
    <set_value name="$index" exact="event.param3.$index"/>
    <do_if value="State.$ships? and State.$byship? and State.$epoch? and State.$faulted? and not State.$faulted and event.param3.$epoch == State.$epoch and $index ge 1 and $index le State.$last and $index == ($index)i and @State.$ships.{$index}.isoperational and State.$ships.{$index}.isclass.ship">
     <set_value name="$ship" exact="State.$ships.{$index}"/>
     <do_if value="@State.$byship.{$ship} == $index">
      <raise_lua_event name="'X4AuthorityShipRegistry.Actor'" param="$ship"/>
     </do_if>
     <do_else>
      <set_value name="State.$faulted" exact="true"/>
      <raise_lua_event name="'X4AuthorityShipRegistry.Unavailable'"/>
     </do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityShipRegistry.Unavailable'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
