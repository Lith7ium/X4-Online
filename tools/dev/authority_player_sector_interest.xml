<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in read-only player sector query; the sector reference stays local. -->
<mdscript name="X4AuthorityPlayerSectorInterest" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityPlayerSectorInterest'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$r" exact="event.param3"/>
   <do_if value="@player.sector.isclass.sector and @player.sector.macro.id">
    <raise_lua_event name="'X4AuthorityPlayerSectorInterest.Result'" param="'%s|%s|%s|ok|%s|%s'.[$r.$request_id,$r.$epoch,$r.$incarnation,player.sector,player.sector.macro.id]"/>
   </do_if>
   <do_else><raise_lua_event name="'X4AuthorityPlayerSectorInterest.Result'" param="'%s|%s|%s|unavailable'.[$r.$request_id,$r.$epoch,$r.$incarnation]"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
