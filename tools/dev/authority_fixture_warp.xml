<?xml version="1.0" encoding="utf-8"?>
<!-- One-shot, isolated disposable fixture observation only. -->
<mdscript name="X4LAN_FixtureWarp" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Once">
   <conditions><event_ui_triggered screen="'X4LAN_FixtureWarp'" control="'Once'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <do_if value="md.X4LAN_NativeGate.Spawn.$ships? and @md.X4LAN_NativeGate.Spawn.$ships.count == 12">
     <set_value name="$ship" exact="md.X4LAN_NativeGate.Spawn.$ships.{1}"/>
     <!-- Parent is checked in MD, immediately before the engine operation.
          This is not an atomicity or collision-clearance assertion. -->
     <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship == $v.$ship and $ship.sector == $v.$sector and $ship.parent == $v.$parent and $ship.parent.isclass.zone and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
      <warp object="$ship" sector="$v.$sector"><position x="$v.$x * 1m" y="$v.$y * 1m" z="$v.$z * 1m"/></warp>
      <raise_lua_event name="'X4LAN_FixtureWarp.Result'" param="'applied'"/>
     </do_if>
     <do_else><raise_lua_event name="'X4LAN_FixtureWarp.Result'" param="'refused'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4LAN_FixtureWarp.Result'" param="'refused'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
