<?xml version="1.0" encoding="utf-8"?>
<!-- Default-off, read-only local replica binding; not a cross-process frame proof. -->
<mdscript name="X4AuthorityReplicaMotionBind" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Bind" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityReplicaMotionBind'" control="'Bind'"/></conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <set_value name="$ok" exact="false"/>
    <do_if value="$r.$request_id? and $r.$epoch? and $r.$index? and $r.$sector_macro?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted?">
      <do_if value="md.X4AuthorityMultiCreateReceiver.State.$epoch? and md.X4AuthorityMultiCreateReceiver.State.$receipts? and md.X4AuthorityMultiCreateReceiver.State.$faulted? and md.X4AuthorityMultiCreateReceiver.State.$pending?">
       <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and not md.X4AuthorityMultiCreateReceiver.State.$faulted and not md.X4AuthorityMultiCreateReceiver.State.$pending and $r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $r.$epoch == md.X4AuthorityMultiCreateReceiver.State.$epoch">
        <do_if value="$r.$index ge 1 and $r.$index le md.X4AuthorityShipRegistry.State.$last and $r.$index == ($r.$index)i">
         <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$index}"/>
         <find_sector name="$matches" macro="macro.{$r.$sector_macro}" multiple="true" required="false"/>
         <do_if value="@$ship.isoperational and $ship.isclass.ship and not $ship.dock.exists and not $ship.isinternallystored">
          <do_if value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} == $r.$index and @md.X4AuthorityMultiCreateReceiver.State.$receipts.{$r.$index} == $ship and @$matches.count == 1 and @$matches.{1}.isclass.sector">
           <do_if value="@$ship.sector.isclass.sector and $ship.sector == $matches.{1} and $ship.sector.macro.id == $r.$sector_macro">
            <set_value name="$sector" exact="$ship.sector"/>
            <set_value name="$ok" exact="true"/>
           </do_if>
          </do_if>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$ok">
     <raise_lua_event name="'X4AuthorityReplicaMotionBind.Result'" param="'%s|Bound|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$sector]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityReplicaMotionBind.Result'" param="'%s|Unavailable|'.[$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
