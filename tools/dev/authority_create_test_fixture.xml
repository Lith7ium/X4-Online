<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable MD experiment only. No network transport or production integration. -->
<mdscript name="X4AuthorityCreateFixture" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <!-- Trigger on the server only after the common checkpoint was saved. -->
  <cue name="Spawn" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityCreateFixture'" control="'Spawn'"/></conditions>
   <actions>
    <do_if value="player.module == 'custom_creative' and player.ship and player.sector">
     <set_value name="$macro" exact="macro.ship_arg_s_fighter_01_a_macro"/>
     <set_value name="$sector" exact="player.sector"/>
     <set_value name="$owner" exact="faction.argon"/>
     <set_value name="$seed" exact="7183"/>
     <set_value name="$x" exact="-400m"/>
     <set_value name="$y" exact="100km"/>
     <set_value name="$z" exact="500m"/>
     <create_ship name="$ship" macro="$macro" sector="$sector" seed="$seed">
      <owner exact="$owner" overridenpc="true"/>
      <loadout><level exact="1.0"/><variation exact="0"/></loadout>
      <position x="$x" y="$y" z="$z"/>
     </create_ship>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship.macro == $macro and $ship.sector == $sector and $ship.owner == $owner">
      <raise_lua_event name="'X4AuthorityCreateFixture.Ship'" param="$ship"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.SectorId'" param="$ship.sector.macro.id"/>
      <!-- Names are read from the actual created object. Coordinates describe
           the create request; they are not a pose readback. -->
      <raise_lua_event name="'X4AuthorityCreateFixture.Macro'" param="$ship.macro.id"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Owner'" param="$ship.owner.id"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Seed'" param="$seed"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.X'" param="$x / 1m"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Y'" param="$y / 1m"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Z'" param="$z / 1m"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Spawned'"/>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityCreateFixture.SpawnFailed'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityCreateFixture.SpawnFailed'"/></do_else>
   </actions>
  </cue>
  <!-- Request on each instance, without creating an object. Values are local MD objects. -->
  <cue name="Descriptor" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityCreateFixture'" control="'Descriptor'"/></conditions>
   <actions>
    <do_if value="player.module == 'custom_creative' and player.ship and player.sector">
     <!-- Compare the fixed fixture's local sector with the received name. -->
     <raise_lua_event name="'X4AuthorityCreateFixture.SectorId'" param="player.sector.macro.id"/>
     <raise_lua_event name="'X4AuthorityCreateFixture.Described'"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityCreateFixture.DescribeFailed'"/></do_else>
   </actions>
  </cue>
  <!-- Run on the receiver with epoch and index; these are local values. -->
  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityCreateFixture'" control="'Inspect'"/></conditions>
   <actions>
    <set_value name="$index" exact="event.param3.$index"/>
    <set_value name="$epoch" exact="event.param3.$epoch"/>
    <do_if value="md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipCreateReceiver.State.$receipts? and md.X4AuthorityShipCreateReceiver.State.$epoch? and $epoch == md.X4AuthorityShipRegistry.State.$epoch and $epoch == md.X4AuthorityShipCreateReceiver.State.$epoch and $index ge 1 and $index == ($index)i">
     <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
     <set_value name="$receipt" exact="@md.X4AuthorityShipCreateReceiver.State.$receipts.{$index}"/>
     <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship.macro == macro.ship_arg_s_fighter_01_a_macro and $ship.sector == player.sector and $ship.owner == faction.argon">
      <set_value name="$reverse" exact="@md.X4AuthorityShipRegistry.State.$byship.{$ship}"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.RegistryShip'" param="$ship"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Reverse'" param="$reverse"/>
      <raise_lua_event name="'X4AuthorityCreateFixture.Receipt'" param="$receipt"/>
      <do_if value="$reverse == $index and $receipt == $ship">
       <raise_lua_event name="'X4AuthorityCreateFixture.Inspected'" param="$index"/>
      </do_if>
      <do_else><raise_lua_event name="'X4AuthorityCreateFixture.InspectFailed'"/></do_else>
     </do_if>
     <do_else><raise_lua_event name="'X4AuthorityCreateFixture.InspectFailed'"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityCreateFixture.InspectFailed'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
