<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable test only: validates references; the Lua diagnostic owns the one setter. -->
<mdscript name="X4AuthoritySavedMotionApply" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Inspect" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthoritySavedMotionApply'" control="'Inspect'"/></conditions>
  <actions>
   <set_value name="$r" exact="event.param3"/>
   <set_value name="$ok" exact="false"/>
   <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship?">
    <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and @$r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$last ge 1318 and @$r.$index == 1318">
     <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{1318}"/>
     <find_sector name="$sectors" macro="macro.cluster_115_sector001_macro" multiple="true" required="false"/>
     <do_if value="@$sectors.count == 1 and @$ship.isoperational and $ship.isclass.ship and @$ship == @$r.$actor and @$ship.sector == $sectors.{1}">
      <do_if value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} == 1318 and @$ship.sector == @$r.$sector and @$ship.parent == @$r.$zone and @$ship.parent.isclass.zone">
       <do_if value="$ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
        <set_value name="$ok" exact="true"/>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </do_if>
   <do_if value="$ok"><raise_lua_event name="'X4AuthoritySavedMotionApply.Result'" param="'%s|ok'.[$r.$request_id]"/></do_if>
   <do_else><raise_lua_event name="'X4AuthoritySavedMotionApply.Result'" param="'%s|refused'.[$r.$request_id]"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
