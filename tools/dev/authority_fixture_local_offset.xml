<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable diagnostic: resolve only inside the current X4 process. -->
<mdscript name="X4AuthorityFixtureLocalOffset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Inspect" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityFixtureLocalOffset'" control="'Inspect'"/></conditions>
  <actions>
   <set_value name="$r" exact="event.param3"/>
   <set_value name="$valid" exact="false"/>
   <do_if value="@$r.$request_id and @$r.$epoch and (@$r.$slot == 1 or @$r.$slot == 2)">
    <do_if value="md.X4AuthorityPlayerSectorFixture.State.$ready? and md.X4AuthorityPlayerSectorFixture.State.$pending? and md.X4AuthorityPlayerSectorFixture.State.$faulted? and md.X4AuthorityPlayerSectorFixture.State.$epoch?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship?">
      <do_if value="md.X4AuthorityPlayerSectorFixture.State.$ready and not md.X4AuthorityPlayerSectorFixture.State.$pending and not md.X4AuthorityPlayerSectorFixture.State.$faulted and $r.$epoch == md.X4AuthorityPlayerSectorFixture.State.$epoch">
       <do_if value="$r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$last == 4">
        <set_value name="$index" exact="$r.$slot + 2"/>
        <do_if value="$r.$slot == 1"><set_value name="$ship" exact="md.X4AuthorityPlayerSectorFixture.State.$ship1"/><set_value name="$sector" exact="md.X4AuthorityPlayerSectorFixture.State.$sector1"/></do_if>
        <do_else><set_value name="$ship" exact="md.X4AuthorityPlayerSectorFixture.State.$ship2"/><set_value name="$sector" exact="md.X4AuthorityPlayerSectorFixture.State.$sector2"/></do_else>
        <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship.owner == faction.player and $ship.macro == macro.ship_arg_s_fighter_01_a_macro">
         <do_if value="@$sector.isclass.sector and $ship.sector == $sector and @$ship.parent.isclass.zone">
          <do_if value="@md.X4AuthorityShipRegistry.State.$ships.{$index} == $ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index">
           <do_if value="not $ship.dock.exists and not $ship.isinternallystored and $ship != player.ship and $ship != player.occupiedship">
            <do_if value="$ship != player.controlled and $ship != player.container"><set_value name="$valid" exact="true"/></do_if>
           </do_if>
          </do_if>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </do_if>
   <do_if value="$valid"><raise_lua_event name="'X4AuthorityFixtureLocalOffset.Result'" param="'%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$epoch,$index,$ship,$sector,$ship.parent]"/></do_if>
   <do_else><raise_lua_event name="'X4AuthorityFixtureLocalOffset.Refused'"/></do_else>
  </actions>
 </cue></cues>
</mdscript>
