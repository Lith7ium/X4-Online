<?xml version="1.0" encoding="utf-8"?>
<!-- Default-off full-register experiment. Registry and game objects are read-only. -->
<mdscript name="X4AuthorityRegistryAvailabilitySnapshot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityRegistryAvailabilitySnapshot'" control="'Initialize'"/></conditions>
   <actions>
    <set_value name="$request" exact="event.param3"/>
    <do_if value="not State.$format? and not State.$epoch? and not State.$run_id? and not State.$issued_count? and not State.$cursor? and not State.$available_count? and not State.$unavailable_count? and not State.$sealed? and not State.$faulted? and not State.$available? and not State.$ships? and not State.$byship? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and $request.$request_id? and $request.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $request.$run_id? and $request.$issued_count == md.X4AuthorityShipRegistry.State.$last and $request.$issued_count ge 1 and $request.$issued_count le 200000 and $request.$issued_count == ($request.$issued_count)i">
     <set_value name="State.$format" exact="2"/>
     <set_value name="State.$epoch" exact="$request.$epoch"/>
     <set_value name="State.$run_id" exact="$request.$run_id"/>
     <set_value name="State.$issued_count" exact="$request.$issued_count"/>
     <set_value name="State.$cursor" exact="0"/>
     <set_value name="State.$available_count" exact="0"/>
     <set_value name="State.$unavailable_count" exact="0"/>
     <set_value name="State.$sealed" exact="false"/>
     <set_value name="State.$faulted" exact="false"/>
     <set_value name="State.$available" exact="table[]"/>
     <set_value name="State.$ships" exact="table[]"/>
     <set_value name="State.$byship" exact="table[]"/>
     <raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Initialize|Initialized|%s'.[$request.$request_id,State.$run_id,State.$issued_count]"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Initialize|Refused'.[$request.$request_id,$request.$run_id]"/></do_else>
   </actions>
  </cue>

  <cue name="Capture" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityRegistryAvailabilitySnapshot'" control="'Capture'"/></conditions>
   <actions>
    <set_value name="$request" exact="event.param3"/>
    <set_value name="$first" exact="$request.$first"/>
    <set_value name="$count" exact="$request.$count"/>
    <do_if value="State.$format? and State.$epoch? and State.$run_id? and State.$issued_count? and State.$cursor? and State.$available_count? and State.$unavailable_count? and State.$available? and State.$ships? and State.$byship? and State.$sealed? and State.$faulted? and State.$format == 2 and not State.$faulted and not State.$sealed and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and md.X4AuthorityShipRegistry.State.$last == State.$issued_count and $request.$epoch == State.$epoch and $request.$run_id == State.$run_id and $request.$request_id? and $first == State.$cursor + 1 and $first == ($first)i and $count ge 1 and $count le 64 and $count == ($count)i and $first + $count - 1 le State.$issued_count">
     <set_value name="$bits" exact="''"/>
     <set_value name="$chunk_available" exact="0"/>
     <set_value name="$chunk_unavailable" exact="0"/>
     <set_value name="$chunk_fault" exact="false"/>
     <set_value name="$fault_index" exact="0"/>
     <set_value name="$fault_reason" exact="''"/>
     <do_all exact="$count" counter="$offset">
      <set_value name="$index" exact="$first + $offset - 1"/>
      <do_if value="not md.X4AuthorityShipRegistry.State.$ships.{$index}? or State.$available.{$index}?">
       <set_value name="$chunk_fault" exact="true"/>
       <set_value name="$fault_index" exact="$index"/>
       <set_value name="$fault_reason" exact="'missing_forward_or_duplicate'"/>
      </do_if>
      <do_else>
       <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
       <do_if value="not @$ship.exists">
        <set_value name="State.$available.{$index}" exact="0"/>
        <set_value name="$bits" exact="$bits + '0'"/>
        <set_value name="$chunk_unavailable" exact="$chunk_unavailable + 1"/>
       </do_if>
       <do_else>
        <do_if value="$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and not State.$byship.{$ship}?">
         <set_value name="State.$available.{$index}" exact="1"/>
         <set_value name="State.$ships.{$index}" exact="$ship"/>
         <set_value name="State.$byship.{$ship}" exact="$index"/>
         <set_value name="$bits" exact="$bits + '1'"/>
         <set_value name="$chunk_available" exact="$chunk_available + 1"/>
        </do_if>
        <do_else><set_value name="$chunk_fault" exact="true"/><set_value name="$fault_index" exact="$index"/><set_value name="$fault_reason" exact="'existing_invalid_class_operational_or_reverse'"/></do_else>
       </do_else>
      </do_else>
     </do_all>
     <do_if value="$chunk_fault">
      <set_value name="State.$faulted" exact="true"/>
      <debug_text text="'Availability snapshot capture fault at index %s: %s'.[$fault_index,$fault_reason]"/>
      <raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Capture|Refused'.[$request.$request_id,State.$run_id]"/>
     </do_if>
     <do_else>
      <set_value name="State.$cursor" exact="$first + $count - 1"/>
      <set_value name="State.$available_count" exact="State.$available_count + $chunk_available"/>
      <set_value name="State.$unavailable_count" exact="State.$unavailable_count + $chunk_unavailable"/>
      <raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Capture|%s|%s|Captured|%s|%s|%s'.[$request.$request_id,State.$run_id,$first,$count,State.$available_count,State.$unavailable_count,$bits]"/>
     </do_else>
    </do_if>
    <do_else><do_if value="State.$format? and not State.$sealed"><set_value name="State.$faulted" exact="true"/></do_if><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Capture|Refused'.[$request.$request_id,$request.$run_id]"/></do_else>
   </actions>
  </cue>

  <cue name="Seal" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityRegistryAvailabilitySnapshot'" control="'Seal'"/></conditions>
   <actions>
    <set_value name="$request" exact="event.param3"/>
    <do_if value="State.$format? and State.$epoch? and State.$run_id? and State.$issued_count? and State.$cursor? and State.$available_count? and State.$unavailable_count? and State.$available? and State.$ships? and State.$byship? and State.$sealed? and State.$faulted? and State.$format == 2 and not State.$faulted and not State.$sealed and State.$cursor == State.$issued_count and State.$available_count + State.$unavailable_count == State.$issued_count and $request.$request_id? and $request.$run_id == State.$run_id and $request.$epoch == State.$epoch and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch and md.X4AuthorityShipRegistry.State.$last == State.$issued_count">
     <set_value name="State.$sealed" exact="true"/>
     <raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Seal|Sealed|%s|%s|%s'.[$request.$request_id,State.$run_id,State.$issued_count,State.$available_count,State.$unavailable_count]"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Seal|Refused'.[$request.$request_id,$request.$run_id]"/></do_else>
   </actions>
  </cue>

  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityRegistryAvailabilitySnapshot'" control="'Inspect'"/></conditions>
   <actions>
    <set_value name="$request" exact="event.param3"/>
    <set_value name="$first" exact="$request.$first"/>
    <set_value name="$count" exact="$request.$count"/>
    <do_if value="State.$format? and State.$epoch? and State.$run_id? and State.$issued_count? and State.$cursor? and State.$available_count? and State.$unavailable_count? and State.$available? and State.$ships? and State.$byship? and State.$sealed? and State.$faulted? and State.$format == 2 and State.$sealed and not State.$faulted and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and State.$epoch == md.X4AuthorityShipRegistry.State.$epoch and State.$issued_count == md.X4AuthorityShipRegistry.State.$last and $request.$epoch == State.$epoch and $request.$run_id == State.$run_id and $request.$request_id? and $first ge 1 and $first == ($first)i and $count ge 1 and $count le 64 and $count == ($count)i and $first + $count - 1 le State.$issued_count">
     <set_value name="$saved_bits" exact="''"/>
     <set_value name="$fresh_bits" exact="''"/>
     <set_value name="$inspect_fault" exact="false"/>
     <set_value name="$fault_index" exact="0"/>
     <set_value name="$fault_reason" exact="''"/>
     <do_all exact="$count" counter="$offset">
      <set_value name="$index" exact="$first + $offset - 1"/>
      <do_if value="not State.$available.{$index}? or not md.X4AuthorityShipRegistry.State.$ships.{$index}?">
       <set_value name="$inspect_fault" exact="true"/>
       <set_value name="$fault_index" exact="$index"/>
       <set_value name="$fault_reason" exact="'missing_saved_flag_or_source_forward'"/>
      </do_if>
      <do_else>
       <do_if value="State.$available.{$index} == 1">
        <set_value name="$saved_ship" exact="@State.$ships.{$index}"/>
        <do_if value="State.$ships.{$index}? and @State.$byship.{$saved_ship} == $index">
         <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
         <do_if value="@$ship.exists and $ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and State.$ships.{$index} == $ship and State.$byship.{$ship} == $index">
          <set_value name="$saved_bits" exact="$saved_bits + '1'"/>
          <set_value name="$fresh_bits" exact="$fresh_bits + '1'"/>
         </do_if>
         <do_elseif value="not @$ship.exists">
          <set_value name="$saved_bits" exact="$saved_bits + '1'"/>
          <set_value name="$fresh_bits" exact="$fresh_bits + '0'"/>
         </do_elseif>
         <do_else><set_value name="$inspect_fault" exact="true"/><set_value name="$fault_index" exact="$index"/><set_value name="$fault_reason" exact="'available_binding_mismatch'"/></do_else>
        </do_if>
        <do_else><set_value name="$inspect_fault" exact="true"/><set_value name="$fault_index" exact="$index"/><set_value name="$fault_reason" exact="'saved_available_binding_missing'"/></do_else>
       </do_if>
       <do_elseif value="State.$available.{$index} == 0">
        <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
        <do_if value="not @$ship.exists and not State.$ships.{$index}? and not State.$byship.{$ship}?"><set_value name="$saved_bits" exact="$saved_bits + '0'"/><set_value name="$fresh_bits" exact="$fresh_bits + '0'"/></do_if>
        <do_else><set_value name="$inspect_fault" exact="true"/><set_value name="$fault_index" exact="$index"/><set_value name="$fault_reason" exact="'unavailable_has_snapshot_binding_or_new_source'"/></do_else>
       </do_elseif>
       <do_else><set_value name="$inspect_fault" exact="true"/><set_value name="$fault_index" exact="$index"/><set_value name="$fault_reason" exact="'availability_flag_not_binary'"/></do_else>
      </do_else>
     </do_all>
     <do_if value="not $inspect_fault"><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Inspect|%s|%s|Inspected|%s|%s'.[$request.$request_id,State.$run_id,$first,$count,$saved_bits,$fresh_bits]"/></do_if>
     <do_else><debug_text text="'Availability snapshot inspect fault at index %s: %s'.[$fault_index,$fault_reason]"/><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Inspect|Refused'.[$request.$request_id,State.$run_id]"/></do_else>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityRegistryAvailabilitySnapshot.Result'" param="'%s|%s|Inspect|Refused'.[$request.$request_id,$request.$run_id]"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
