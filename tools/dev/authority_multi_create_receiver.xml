<?xml version='1.0' encoding='utf-8'?>
<!-- Default-off correlated experiment; sector references use saved local witnesses. -->
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="X4AuthorityMultiCreateReceiver" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <!-- This cue and the existing registry are saved together in the test world. -->
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityMultiCreateReceiver'" control="'Initialize'"/></conditions>
   <actions>
    <set_value name="$bounded_guard_1" exact="false"/>
    <do_if value="event.param3.$request_id? and event.param3.$epoch? and event.param3.$baseline? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last?">
     <do_if value="md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted and event.param3.$epoch == md.X4AuthorityShipRegistry.State.$epoch">
      <do_if value="event.param3.$baseline ge 1 and event.param3.$baseline == (event.param3.$baseline)i and event.param3.$baseline == md.X4AuthorityShipRegistry.State.$last">
       <set_value name="$bounded_guard_1" exact="true"/>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$bounded_guard_1">
    <set_value name="$epoch" exact="event.param3.$epoch"/>
    <set_value name="$baseline" exact="event.param3.$baseline"/>
    <set_value name="$receipts" exact="table[]"/>
    <set_value name="$macros" exact="table[]"/>
    <set_value name="$sectors" exact="table[]"/>
    <set_value name="$owners" exact="table[]"/>
    <set_value name="$seeds" exact="table[]"/>
    <set_value name="$xs" exact="table[]"/>
    <set_value name="$ys" exact="table[]"/>
    <set_value name="$zs" exact="table[]"/>
    <set_value name="$pending" exact="false"/>
    <set_value name="$faulted" exact="false"/>
    <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Initialized|%s'.[event.param3.$request_id,$epoch]"/>
    </do_if>
   </actions>
  </cue>
  <cue name="Create" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityMultiCreateReceiver'" control="'Create'"/></conditions>
   <actions>
    <set_value name="$req" exact="event.param3"/>
    <set_value name="$id" exact="$req.$index"/>
    <set_value name="$bounded_guard_2" exact="false"/>
    <do_if value="State.$faulted? and State.$pending? and State.$receipts? and State.$macros? and State.$sectors?">
     <do_if value="State.$owners? and State.$seeds? and State.$xs? and State.$ys? and State.$zs?">
      <do_if value="State.$epoch? and State.$baseline? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$last?">
       <do_if value="md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$epoch? and event.param3.$request_id? and not State.$faulted and not State.$pending">
        <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and $req.$epoch == State.$epoch and $req.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $id ge 1 and $id == ($id)i">
         <set_value name="$bounded_guard_2" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$bounded_guard_2">
     <do_if value="$id le md.X4AuthorityShipRegistry.State.$last">
      <!-- Receipts exist only for objects created by this receiver. Never adopt an unrelated entry. -->
      <set_value name="$s" exact="@md.X4AuthorityShipRegistry.State.$ships.{$id}"/>
      <set_value name="$bounded_guard_3" exact="false"/>
      <do_if value="@State.$receipts.{$id} == $s and @$s.isoperational and $s.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$s} == $id and @State.$macros.{$id} == $req.$macro">
       <do_if value="@State.$sectors.{$id} == $req.$sector and @State.$owners.{$id} == $req.$owner and @State.$seeds.{$id} == $req.$seed and @State.$xs.{$id} == $req.$x and @State.$ys.{$id} == $req.$y">
        <do_if value="@State.$zs.{$id} == $req.$z">
         <set_value name="$bounded_guard_3" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
      <do_if value="$bounded_guard_3">
       <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Created|%s|%s'.[event.param3.$request_id,$id,md.X4AuthorityShipRegistry.State.$ships.{$id}]"/>
      </do_if>
      <do_else>
       <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
       <set_value name="State.$faulted" exact="true"/>
       <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_replay'.[event.param3.$request_id]"/>
      </do_else>
     </do_if>
     <do_elseif value="$id == md.X4AuthorityShipRegistry.State.$last + 1 and not @md.X4AuthorityShipRegistry.State.$ships.{$id} and not @State.$receipts.{$id}">
      <!-- Resolve process-local MD values only from validated portable identifiers. -->
      <set_value name="$macro" exact="@macro.{$req.$macro}"/>
      <!-- A save-baseline witness is resolved entirely in this local process. -->
      <set_value name="$sector" exact="null"/>
      <set_value name="$witness" exact="@md.X4AuthorityShipRegistry.State.$ships.{$req.$witness_index}"/>
      <find_sector name="$matches" macro="macro.{$req.$sector}" multiple="true" required="false"/>
      <set_value name="$bounded_guard_4" exact="false"/>
      <do_if value="$req.$witness_index ge 1 and $req.$witness_index le State.$baseline and $req.$witness_index == ($req.$witness_index)i and @$witness.isoperational and $witness.isclass.ship">
       <do_if value="not $witness.dock.exists and not $witness.isinternallystored and @md.X4AuthorityShipRegistry.State.$byship.{$witness} == $req.$witness_index and @$matches.count == 1 and @$matches.{1}.isclass.sector">
        <do_if value="@$witness.sector.isclass.sector and $witness.sector == $matches.{1} and $witness.sector.macro.id == $req.$sector">
         <set_value name="$bounded_guard_4" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
      <do_if value="$bounded_guard_4">
       <set_value name="$sector" exact="$matches.{1}"/>
      </do_if>
      <set_value name="$owner" exact="null"/>
      <set_value name="$owner_matches" exact="0"/>
      <do_all exact="lookup.faction.count" counter="$i">
       <set_value name="$candidate" exact="lookup.faction.{$i}"/>
       <do_if value="$candidate.id == $req.$owner">
        <set_value name="$owner" exact="$candidate"/>
        <set_value name="$owner_matches" exact="$owner_matches + 1"/>
       </do_if>
      </do_all>
      <set_value name="$bounded_guard_5" exact="false"/>
      <do_if value="$macro and $owner_matches == 1 and typeof $owner == datatype.faction and @$sector.isclass.sector and $sector.macro.id == $req.$sector">
       <do_if value="$req.$seed ge 0 and $req.$seed le 2147483647 and $req.$seed == ($req.$seed)i and $req.$x ge -10000000 and $req.$x le 10000000">
        <do_if value="$req.$y ge -10000000 and $req.$y le 10000000 and $req.$z ge -10000000 and $req.$z le 10000000">
         <set_value name="$bounded_guard_5" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
      <do_if value="$bounded_guard_5">
       <!-- Pending precedes all game mutations. An interrupted request is never retried automatically. -->
       <set_value name="State.$pending" exact="true"/>
       <do_if value="State.$pending">
        <create_ship name="$ship" macro="$macro" sector="$sector" seed="$req.$seed">
         <owner exact="$owner" overridenpc="true"/>
         <loadout><level exact="1.0"/><variation exact="0"/></loadout>
         <position x="($req.$x)m" y="($req.$y)m" z="($req.$z)m"/>
        </create_ship>
        <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship.macro == $macro and $ship.sector == $sector and $ship.owner == $owner and not @md.X4AuthorityShipRegistry.State.$byship.{$ship}">
         <set_value name="State.$macros.{$id}" exact="$req.$macro"/>
         <set_value name="State.$sectors.{$id}" exact="$req.$sector"/>
         <set_value name="State.$owners.{$id}" exact="$req.$owner"/>
         <set_value name="State.$seeds.{$id}" exact="$req.$seed"/>
         <set_value name="State.$xs.{$id}" exact="$req.$x"/>
         <set_value name="State.$ys.{$id}" exact="$req.$y"/>
         <set_value name="State.$zs.{$id}" exact="$req.$z"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{$id}" exact="$ship"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$ship}" exact="$id"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$last" exact="$id"/>
         <set_value name="State.$receipts.{$id}" exact="$ship"/>
         <set_value name="$bounded_guard_6" exact="false"/>
         <do_if value="@md.X4AuthorityShipRegistry.State.$ships.{$id} == $ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $id and md.X4AuthorityShipRegistry.State.$last == $id and @State.$receipts.{$id} == $ship and @State.$macros.{$id} == $req.$macro">
          <do_if value="@State.$sectors.{$id} == $req.$sector and @State.$owners.{$id} == $req.$owner and @State.$seeds.{$id} == $req.$seed and @State.$xs.{$id} == $req.$x and @State.$ys.{$id} == $req.$y">
           <do_if value="@State.$zs.{$id} == $req.$z">
            <set_value name="$bounded_guard_6" exact="true"/>
           </do_if>
          </do_if>
         </do_if>
         <do_if value="$bounded_guard_6">
          <set_value name="State.$pending" exact="false"/>
          <do_if value="not State.$pending">
           <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Created|%s|%s'.[event.param3.$request_id,$id,md.X4AuthorityShipRegistry.State.$ships.{$id}]"/>
          </do_if>
          <do_else>
           <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
           <set_value name="State.$faulted" exact="true"/>
           <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_pending_clear'.[event.param3.$request_id]"/>
          </do_else>
         </do_if>
         <do_else>
          <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
          <set_value name="State.$faulted" exact="true"/>
          <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_registry'.[event.param3.$request_id]"/>
         </do_else>
        </do_if>
        <do_else>
         <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
         <set_value name="State.$faulted" exact="true"/>
         <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_ship'.[event.param3.$request_id]"/>
        </do_else>
       </do_if>
       <do_else>
        <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
        <set_value name="State.$faulted" exact="true"/>
        <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_pending_set'.[event.param3.$request_id]"/>
       </do_else>
      </do_if>
      <do_else>
       <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
       <set_value name="State.$faulted" exact="true"/>
       <set_value name="$refusal" exact="'create_input'"/>
       <do_if value="not $bounded_guard_4"><set_value name="$refusal" exact="'create_witness'"/></do_if>
       <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|%s'.[event.param3.$request_id,$refusal]"/>
      </do_else>
     </do_elseif>
     <do_else>
      <set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/>
      <set_value name="State.$faulted" exact="true"/>
      <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_index'.[event.param3.$request_id]"/>
     </do_else>
    </do_if>
    <do_else>
     <!-- A state that is not initialized cannot safely accept a fault write. -->
     <do_if value="md.X4AuthorityShipRegistry.State.$faulted?"><set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/></do_if>
     <do_if value="State.$faulted?"><set_value name="State.$faulted" exact="true"/></do_if>
     <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|create_state'.[event.param3.$request_id]"/>
    </do_else>
   </actions>
  </cue>
  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityMultiCreateReceiver'" control="'Inspect'"/></conditions>
   <actions>
    <set_value name="$v" exact="event.param3"/>
    <set_value name="$id" exact="@$v.$index"/>
    <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$id}"/>
    <set_value name="$witness" exact="@md.X4AuthorityShipRegistry.State.$ships.{$v.$witness_index}"/>
    <set_value name="$witness_ok" exact="false"/>
    <find_sector name="$matches" macro="macro.{$v.$sector}" multiple="true" required="false"/>
    <set_value name="$bounded_guard_7" exact="false"/>
    <do_if value="State.$baseline? and $v.$witness_index ge 1 and $v.$witness_index le State.$baseline and $v.$witness_index == ($v.$witness_index)i and @$witness.isoperational">
     <do_if value="$witness.isclass.ship and not $witness.dock.exists and not $witness.isinternallystored and @md.X4AuthorityShipRegistry.State.$byship.{$witness} == $v.$witness_index and @$matches.count == 1">
      <do_if value="@$matches.{1}.isclass.sector and @$witness.sector.isclass.sector and $witness.sector == $matches.{1} and $witness.sector.macro.id == $v.$sector">
       <set_value name="$bounded_guard_7" exact="true"/>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$bounded_guard_7">
     <set_value name="$witness_ok" exact="true"/>
    </do_if>
    <set_value name="$binding_ok" exact="false"/>
    <set_value name="$bounded_guard_8" exact="false"/>
    <do_if value="$v.$request_id? and State.$epoch? and State.$pending? and State.$faulted? and State.$receipts?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$byship? and not State.$pending">
      <do_if value="not State.$faulted and not md.X4AuthorityShipRegistry.State.$faulted and $v.$epoch == State.$epoch and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $id ge 1">
       <do_if value="$id le md.X4AuthorityShipRegistry.State.$last and $id == ($id)i and @$ship.isoperational and $ship.isclass.ship and @State.$receipts.{$id} == $ship">
        <do_if value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} == $id">
         <set_value name="$bounded_guard_8" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$bounded_guard_8">
     <set_value name="$binding_ok" exact="true"/>
    </do_if>
    <set_value name="$descriptor_ok" exact="false"/>
    <set_value name="$bounded_guard_9" exact="false"/>
    <do_if value="$binding_ok and $witness_ok and @State.$macros.{$id} == $v.$macro and @State.$sectors.{$id} == $v.$sector and @State.$owners.{$id} == $v.$owner">
     <do_if value="@State.$seeds.{$id} == $v.$seed and @State.$xs.{$id} == $v.$x and @State.$ys.{$id} == $v.$y and @State.$zs.{$id} == $v.$z and $ship.macro.id == $v.$macro">
      <do_if value="$ship.sector == $witness.sector and $ship.sector.macro.id == $v.$sector and $ship.owner.id == $v.$owner">
       <set_value name="$bounded_guard_9" exact="true"/>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="$bounded_guard_9">
     <set_value name="$descriptor_ok" exact="true"/>
    </do_if>
    <do_if value="$binding_ok and $descriptor_ok and $witness_ok">
     <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Inspected|%s|%s|%s'.[$v.$request_id,$id,$ship,$ship.sector]"/>
    </do_if>
    <do_else>
     <do_if value="md.X4AuthorityShipRegistry.State.$faulted?"><set_value name="md.X4AuthorityShipRegistry.State.$faulted" exact="true"/></do_if>
     <do_if value="State.$faulted?"><set_value name="State.$faulted" exact="true"/></do_if>
     <set_value name="$refusal" exact="'inspect_descriptor'"/>
     <do_if value="not $binding_ok"><set_value name="$refusal" exact="'inspect_binding'"/></do_if>
     <do_elseif value="not $witness_ok"><set_value name="$refusal" exact="'inspect_witness'"/></do_elseif>
     <raise_lua_event name="'X4AuthorityMultiCreateReceiver.Result'" param="'%s|Refused|%s'.[$v.$request_id,$refusal]"/>
    </do_else>
   </actions>
  </cue>
 </cues>
</mdscript>