<?xml version="1.0" encoding="utf-8"?>
<!-- Experimental: the state cue owns the persistent marker; store requests repeat. -->
<mdscript name="X4AuthorityPlayerFixtureMarker" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="MarkerState" namespace="this">
   <actions><set_value name="$loaded" exact="false"/></actions>
  </cue>
  <cue name="Store" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityPlayerFixtureMarker'" control="'Store'"/></conditions>
   <actions>
    <set_value name="MarkerState.$marker" exact="event.param3.$marker"/>
    <set_value name="MarkerState.$loaded" exact="false"/>
    <raise_lua_event name="'X4AuthorityPlayerFixtureMarker.Stored'" param="MarkerState.$marker"/>
   </actions>
  </cue>
  <cue name="Loaded" instantiate="true">
   <conditions><event_game_loaded/></conditions>
   <actions>
    <do_if value="MarkerState.$marker?"><set_value name="MarkerState.$loaded" exact="true"/></do_if>
   </actions>
  </cue>
  <cue name="Inspect" instantiate="true">
   <conditions><event_ui_triggered screen="'X4AuthorityPlayerFixtureMarker'" control="'Inspect'"/></conditions>
   <actions>
    <do_if value="MarkerState.$marker? and MarkerState.$loaded? and MarkerState.$loaded">
     <raise_lua_event name="'X4AuthorityPlayerFixtureMarker.Inspected'" param="MarkerState.$marker"/>
    </do_if>
    <do_else><raise_lua_event name="'X4AuthorityPlayerFixtureMarker.Missing'"/></do_else>
   </actions>
  </cue>
 </cues>
</mdscript>
