<?xml version="1.0" encoding="utf-8"?>
<!-- One disposable controlled-fixture impulse. The caller owns process cleanup. -->
<mdscript name="X4AuthorityFixtureClientThrottle" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityFixtureClientThrottle'" control="'Start'"/></conditions>
   <actions>
    <set_value name="$request" exact="event.param3"/>
    <set_value name="$started" exact="false"/>
    <do_if value="@$request.$request_id and @$request.$epoch and (@$request.$slot == 1 or @$request.$slot == 2)">
     <do_if value="md.X4AuthorityPlayerSectorFixture.State.$ready? and md.X4AuthorityPlayerSectorFixture.State.$pending? and md.X4AuthorityPlayerSectorFixture.State.$faulted? and md.X4AuthorityPlayerSectorFixture.State.$epoch?">
      <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship?">
       <do_if value="md.X4AuthorityPlayerSectorFixture.State.$ready and not md.X4AuthorityPlayerSectorFixture.State.$pending and not md.X4AuthorityPlayerSectorFixture.State.$faulted and $request.$epoch == md.X4AuthorityPlayerSectorFixture.State.$epoch">
        <do_if value="$request.$epoch == md.X4AuthorityShipRegistry.State.$epoch and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$last == 4">
         <set_value name="$index" exact="$request.$slot + 2"/>
         <do_if value="$request.$slot == 1"><set_value name="$ship" exact="md.X4AuthorityPlayerSectorFixture.State.$ship1"/><set_value name="$sector" exact="md.X4AuthorityPlayerSectorFixture.State.$sector1"/></do_if>
         <do_else><set_value name="$ship" exact="md.X4AuthorityPlayerSectorFixture.State.$ship2"/><set_value name="$sector" exact="md.X4AuthorityPlayerSectorFixture.State.$sector2"/></do_else>
         <do_if value="@$ship.isoperational and $ship.isclass.ship and $ship.owner == faction.player and $ship.macro == macro.ship_arg_s_fighter_01_a_macro">
          <do_if value="@$sector.isclass.sector and $ship.sector == $sector and not $ship.dock.exists and not $ship.isinternallystored">
           <do_if value="@md.X4AuthorityShipRegistry.State.$ships.{$index} == $ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index">
            <do_if value="player.ship == $ship and player.occupiedship == $ship and player.controlled == $ship and player.container == $ship">
             <set_value name="$started" exact="true"/>
             <set_playership_throttle value="0.2"/>
             <raise_lua_event name="'X4AuthorityFixtureClientThrottle.Started'" param="'%s|%s|%s'.[$request.$request_id,$request.$epoch,$request.$slot]"/>
            </do_if>
           </do_if>
          </do_if>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
    <do_if value="not $started"><raise_lua_event name="'X4AuthorityFixtureClientThrottle.Refused'" param="'start'"/></do_if>
   </actions>
   <cues>
    <cue name="Stop">
     <delay exact="1s"/>
     <actions>
      <set_value name="$safe" exact="false"/>
      <set_value name="$slotmatches" exact="false"/>
      <do_if value="State.$started">
       <do_if value="State.$request.$slot == 1">
        <do_if value="State.$ship == md.X4AuthorityPlayerSectorFixture.State.$ship1 and State.$sector == md.X4AuthorityPlayerSectorFixture.State.$sector1"><set_value name="$slotmatches" exact="true"/></do_if>
       </do_if>
       <do_elseif value="State.$request.$slot == 2">
        <do_if value="State.$ship == md.X4AuthorityPlayerSectorFixture.State.$ship2 and State.$sector == md.X4AuthorityPlayerSectorFixture.State.$sector2"><set_value name="$slotmatches" exact="true"/></do_if>
       </do_elseif>
      </do_if>
      <do_if value="State.$started and $slotmatches and md.X4AuthorityPlayerSectorFixture.State.$ready and not md.X4AuthorityPlayerSectorFixture.State.$pending and not md.X4AuthorityPlayerSectorFixture.State.$faulted">
       <do_if value="State.$request.$epoch == md.X4AuthorityPlayerSectorFixture.State.$epoch and State.$request.$epoch == md.X4AuthorityShipRegistry.State.$epoch and not md.X4AuthorityShipRegistry.State.$faulted and md.X4AuthorityShipRegistry.State.$last == 4">
        <do_if value="@md.X4AuthorityShipRegistry.State.$ships.{State.$index} == State.$ship and @md.X4AuthorityShipRegistry.State.$byship.{State.$ship} == State.$index">
         <do_if value="@State.$ship.isoperational and State.$ship.isclass.ship and State.$ship.owner == faction.player and State.$ship.macro == macro.ship_arg_s_fighter_01_a_macro and State.$ship.sector == State.$sector">
          <do_if value="not State.$ship.dock.exists and not State.$ship.isinternallystored and player.ship == State.$ship and player.occupiedship == State.$ship">
           <do_if value="player.controlled == State.$ship and player.container == State.$ship"><set_value name="$safe" exact="true"/></do_if>
          </do_if>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
      <do_if value="$safe">
       <set_playership_throttle value="0"/>
       <raise_lua_event name="'X4AuthorityFixtureClientThrottle.Stopped'" param="'%s|%s|%s'.[State.$request.$request_id,State.$request.$epoch,State.$request.$slot]"/>
      </do_if>
      <do_elseif value="State.$started"><raise_lua_event name="'X4AuthorityFixtureClientThrottle.Refused'" param="'stop'"/></do_elseif>
     </actions>
    </cue>
   </cues>
  </cue>
 </cues>
</mdscript>
